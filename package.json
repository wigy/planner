{
  "name": "planner",
  "version": "0.1.0",
  "description": "Todo board, Google Calendar month and week views with two-way sync, and time bookkeeping per project",
  "author": "Tommi Ronkainen",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fullcalendar/core": "~6.1.22",
    "@fullcalendar/daygrid": "~6.1.22",
    "@fullcalendar/interaction": "~6.1.22",
    "@fullcalendar/react": "~6.1.22",
    "@fullcalendar/timegrid": "~6.1.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
